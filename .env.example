# Copie para .env e ajuste. Nunca commite o .env.

# Pasta "profiles/BBL" do Bambu Studio (padrão: instalação do macOS em /Applications).
# FILAMENTOR_PROFILES_DIR=/Applications/BambuStudio.app/Contents/Resources/profiles/BBL

# Executável do Bambu Studio usado pelo CLI.
# FILAMENTOR_BAMBU_STUDIO_BIN=/Applications/BambuStudio.app/Contents/MacOS/BambuStudio

# Chave da API Anthropic (fase F4).
# ANTHROPIC_API_KEY=
